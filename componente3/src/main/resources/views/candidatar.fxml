<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="componente3.controller.CandidatarController"
      stylesheets="@../css/style.css"
      padding="20">

    <Label text="Submeter Candidatura" style="-fx-font-size: 20px;"/>

    <TextArea fx:id="cartaArea" promptText="Escreva aqui a carta de motivação"
              prefWidth="300" prefHeight="150"/>

    <Label fx:id="errorLabel" textFill="red"/>

    <Button text="Enviar Candidatura" onAction="#submeter"/>
    <Button text="Voltar" onAction="#voltar"/>
</VBox>