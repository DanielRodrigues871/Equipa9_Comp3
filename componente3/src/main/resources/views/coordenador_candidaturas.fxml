<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?> 
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="componente3.controller.CoordenadorCandidaturasController">
    
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Gestão de Candidaturas" style="-fx-font-weight: bold; -fx-font-size: 24px;" />
        
        <Pane HBox.hgrow="ALWAYS" /> 
        
        <Button text="➕ Nova Candidatura Manual" onAction="#criarCandidaturaManual" 
                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <Separator />

    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Filtrar por:" style="-fx-font-weight: bold;"/>
        
        <ComboBox fx:id="cbFiltroOferta" promptText="Todas as Ofertas..." prefWidth="300.0"/>
        <ComboBox fx:id="cbFiltroEstudante" promptText="Todos os Estudantes..." prefWidth="300.0"/>
        
        <Button text="🔍 Filtrar" onAction="#aplicarFiltros" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="Limpar" onAction="#limparFiltros" style="-fx-cursor: hand;"/>
    </HBox>
    
    <TableView fx:id="tabelaCandidaturas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEstudante" text="Estudante" prefWidth="200.0"/>
            <TableColumn fx:id="colOferta" text="Oferta" prefWidth="200.0"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="100.0"/>
            <TableColumn fx:id="colEstado" text="Estado Atual" prefWidth="120.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="📝 Colocar em Análise" onAction="#colocarEmAnalise" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="❌ Rejeitar" onAction="#rejeitar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="✅ Aprovar" onAction="#aprovar" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>