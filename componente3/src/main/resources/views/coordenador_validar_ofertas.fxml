<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="componente3.controller.CoordenadorValidarOfertasController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
    
    <Label text="Validar Ofertas Pendentes" style="-fx-font-weight: bold; -fx-font-size: 24px;" />
    
    <TableView fx:id="tabelaPendentes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="200.0"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150.0"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100.0"/>
            <TableColumn fx:id="colData" text="Data Submissão" prefWidth="120.0"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="❌ Rejeitar" onAction="#rejeitarOferta" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="✅ Aprovar" onAction="#aprovarOferta" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>