<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="componente3.controller.LoginController">
   
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" 
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/Gemini_Generated_Image_9m5poe9m5poe9m5p.png" />
         </image>
         <effect>
            <GaussianBlur radius="8.0" />
         </effect>
      </ImageView>

      <VBox alignment="CENTER" fillWidth="false">
         <children>
            
            <VBox alignment="CENTER" prefWidth="400.0" spacing="20.0" 
                  style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 0);">
               
               <padding>
                  <Insets bottom="50.0" left="40.0" right="40.0" top="50.0" />
               </padding>

               <children>
                  <Label text="Bem-vindo de volta" 
                         style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 24px;">
                  </Label>
                  
                  <Label text="Aceda ao Portal de Estágios" textFill="#7f8c8d">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>

                  <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" style="-fx-font-weight: bold;"/>

                  <TextField fx:id="emailField" promptText="Email" prefHeight="45.0" 
                             style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />
                  
                  <PasswordField fx:id="passwordField" promptText="Password" prefHeight="45.0" 
                                 style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />

                  <Button fx:id="loginBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#login" 
                          style="-fx-background-color: #0056b3; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 15px;" 
                          text="ENTRAR">
                     <padding>
                        <Insets bottom="12.0" top="12.0" />
                     </padding>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#voltar" 
                          style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-cursor: hand; -fx-underline: true; -fx-font-size: 13px;" 
                          text="Voltar ao início">
                  </Button>

               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>