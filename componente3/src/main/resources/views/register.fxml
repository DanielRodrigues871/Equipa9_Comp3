<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="componente3.controller.RegisterController">
   
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" 
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/Gemini_Generated_Image_9m5poe9m5poe9m5p.png" />
         </image>
         <effect>
            <GaussianBlur radius="8.0" />
         </effect>
      </ImageView>

      <VBox alignment="CENTER" fillWidth="false">
         <children>
            <VBox alignment="CENTER" prefWidth="400.0" spacing="20.0" 
                  style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 0);">
               
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>

               <children>
                  <Label text="Criar Nova Conta" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  
                  <Label text="Selecione o seu perfil para começar" textFill="#7f8c8d">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>

                  <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" style="-fx-font-weight: bold;"/>

                  <ComboBox fx:id="tipoCombo" maxWidth="Infinity" prefHeight="40.0" 
                            promptText="Selecione o tipo de utilizador" 
                            style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />

                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#continuar" 
                          style="-fx-background-color: #0056b3; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" 
                          text="CONTINUAR">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="12.0" top="12.0" />
                     </padding>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#voltarLogin" 
                          style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-cursor: hand; -fx-underline: true;" 
                          text="Voltar ao Login">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>