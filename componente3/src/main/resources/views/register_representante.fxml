<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="componente3.controller.RegisterRepresentanteController">
   
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" 
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/Gemini_Generated_Image_9m5poe9m5poe9m5p.png" />
         </image>
         <effect>
            <GaussianBlur radius="8.0" />
         </effect>
      </ImageView>

      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
         <content>
            <VBox alignment="CENTER" fillWidth="false" minHeight="700.0" style="-fx-background-color: transparent;">
               <children>
                  
                  <VBox alignment="CENTER" prefWidth="450.0" spacing="15.0" 
                        style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 0);">
                     
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>

                     <children>
                        <Label text="Registo de Representante" 
                               style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 24px;">
                        </Label>
                        
                        <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" style="-fx-font-weight: bold;"/>

                        <Label alignment="CENTER_LEFT" maxWidth="Infinity" text="Dados Pessoais" 
                               style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 13px;">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>

                        <TextField fx:id="nomeField" promptText="Nome Completo" prefHeight="40.0" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />
                        
                        <TextField fx:id="emailField" promptText="Email Corporativo" prefHeight="40.0" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />
                        
                        <PasswordField fx:id="passwordField" promptText="Password" prefHeight="40.0" 
                                       style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />

                        <Label alignment="CENTER_LEFT" maxWidth="Infinity" text="Dados Profissionais" 
                               style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 13px;">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>

                        <ComboBox fx:id="empresaCombo" maxWidth="Infinity" promptText="Selecione a Empresa" prefHeight="40.0"
          style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;"/>
          
                        <TextField fx:id="cargoField" promptText="Cargo / Função" prefHeight="40.0" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />
                        
                        <TextField fx:id="telefoneField" promptText="Telefone de Contacto (Opcional)" prefHeight="40.0" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: black;" />

                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#registar" 
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;" 
                                text="CONCLUIR REGISTO">
                           <padding>
                              <Insets bottom="12.0" top="12.0" />
                           </padding>
                           <VBox.margin>
                              <Insets top="15.0" />
                           </VBox.margin>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#voltar" 
                                style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-cursor: hand; -fx-underline: true; -fx-font-size: 13px;" 
                                text="Cancelar e Voltar">
                        </Button>

                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</StackPane>