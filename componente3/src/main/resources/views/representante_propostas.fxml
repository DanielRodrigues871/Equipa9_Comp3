<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="componente3.controller.RepresentantePropostasController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="As Minhas Propostas" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>
        
        <Pane HBox.hgrow="ALWAYS" /> 
        
        <Button text="🔄 Atualizar Lista" onAction="#carregar" 
                style="-fx-cursor: hand; -fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colTitulo" text="Título da Oferta" prefWidth="300.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colVagas" text="Vagas" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colDuracao" text="Duração (Meses)" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
        </columns>
        
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        
        <Button text="Voltar" onAction="#voltar" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Button text="✏️ Editar Selecionada" onAction="#editar" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Button text="➕ Criar Nova" onAction="#criarNova" 
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <font>
                <Font size="14.0" />
            </font>
        </Button>

    </HBox>

</VBox>