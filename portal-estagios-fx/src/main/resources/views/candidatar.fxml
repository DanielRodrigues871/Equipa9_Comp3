<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.CandidatarController">

    <!-- ===================== TOP ===================== -->
    <top>
        <HBox spacing="10" padding="10">
            <Label text="Submeter Candidatura"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar" onAction="#voltar"/>
        </HBox>
    </top>

    <!-- ===================== LEFT (NAVIGATION) ===================== -->
    <left>
        <VBox spacing="10" padding="10" prefWidth="180">
            <Label text="Navigation"
                   style="-fx-font-weight: bold;"/>

            <Button text="Ofertas Aprovadas"/>
            <Button text="Minhas Candidaturas"/>
            <Button text="Submeter Candidatura" disable="true"/>
            <Button text="Notificações"/>
            <Button text="Logout"/>
        </VBox>
    </left>

    <!-- ===================== CENTER ===================== -->
    <center>
        <VBox spacing="15" padding="20" alignment="TOP_LEFT">

            <Label text="Carta de Motivação"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <TextArea fx:id="cartaArea"
                      promptText="Escreva aqui a sua carta de motivação"
                      prefWidth="500"
                      prefHeight="200"/>

            <Label fx:id="errorLabel" textFill="red"/>

        </VBox>
    </center>

    <!-- ===================== BOTTOM ===================== -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" padding="10">
            <Button text="Enviar Candidatura" onAction="#submeter"/>
        </HBox>
    </bottom>

</BorderPane>
