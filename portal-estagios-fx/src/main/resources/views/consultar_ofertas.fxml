<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.ConsultarOfertasController">

    <!-- ===================== TOP ===================== -->
    <top>
        <HBox spacing="10" padding="10">
            <Label text="Ofertas Aprovadas"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar" onAction="#voltarDashboard"/>
        </HBox>
    </top>

    <!-- ===================== LEFT (NAVIGATION) ===================== -->
    <left>
        <VBox spacing="10" padding="10" prefWidth="180">
            <Label text="Navigation"
                   style="-fx-font-weight: bold;"/>

            <Button text="Ofertas Aprovadas" disable="true"/>
            <Button text="Minhas Candidaturas"/>
            <Button text="Notificações"/>
            <Button text="Logout"/>
        </VBox>
    </left>

    <!-- ===================== CENTER ===================== -->
    <center>
        <VBox spacing="10" padding="10">

            <TableView fx:id="tabelaOfertas" prefHeight="400">

                <columns>
                    <TableColumn text="Título" prefWidth="240">
                        <cellValueFactory>
                            <PropertyValueFactory property="titulo"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="Empresa" prefWidth="220">
                        <cellValueFactory>
                            <PropertyValueFactory property="empresa"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="Vagas" prefWidth="80">
                        <cellValueFactory>
                            <PropertyValueFactory property="vagas"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="Duração (meses)" prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="duracao"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>

                <placeholder>
                    <Label text="No content in table"/>
                </placeholder>

            </TableView>

        </VBox>
    </center>

    <!-- ===================== BOTTOM ===================== -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" padding="10">
            <Button text="Candidatar" onAction="#abrirCandidatura"/>
        </HBox>
    </bottom>

</BorderPane>
