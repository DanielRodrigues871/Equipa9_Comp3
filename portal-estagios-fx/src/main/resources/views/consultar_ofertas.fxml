<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.ConsultarOfertasController"
            stylesheets="@../css/style.css">

    <top>
        <Label text="Ofertas Aprovadas"
               style="-fx-font-size: 22px; -fx-padding: 15;"/>
    </top>

    <center>
        <TableView fx:id="tabelaOfertas" prefHeight="400">

            <columns>
                <TableColumn text="Título" prefWidth="200">
                    <cellValueFactory>
                        <PropertyValueFactory property="titulo"/>
                    </cellValueFactory>
                </TableColumn>

                <TableColumn text="Duração" prefWidth="100">
                    <cellValueFactory>
                        <PropertyValueFactory property="duracaoMeses"/>
                    </cellValueFactory>
                </TableColumn>

                <TableColumn text="Vagas" prefWidth="80">
                    <cellValueFactory>
                        <PropertyValueFactory property="numeroVagas"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>

        </TableView>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15;">
            <Button text="Candidatar" onAction="#abrirCandidatura"/>
            <Button text="Voltar" onAction="#voltarDashboard"/>
        </HBox>
    </bottom>

</BorderPane>
