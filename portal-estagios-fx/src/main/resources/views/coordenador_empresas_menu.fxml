<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="contentPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.upt.pt.fx.controller.MenuEmpresasCoordenadorController">

    <VBox spacing="15" alignment="CENTER_LEFT">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Gestão de Empresas (Coordenador)"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Button text="Ver Dados da Empresa" onAction="#verEmpresa" style="-fx-cursor: hand;"/>
        <Button text="Atualizar Dados da Empresa" onAction="#editarEmpresa" style="-fx-cursor: hand;"/>
        <Button text="Listar Todas as Empresas" onAction="#listarEmpresas" style="-fx-cursor: hand;"/>
        <Button text="Voltar" onAction="#voltar" style="-fx-cursor: hand;"/>
    </VBox>

</AnchorPane>
