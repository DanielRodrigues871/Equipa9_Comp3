<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" 
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.upt.pt.fx.controller.CoordenadorGerirPropostasController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Gestão de Propostas de Estágio" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    
    <Label text="Histórico completo de todas as propostas submetidas." style="-fx-text-fill: #7f8c8d;" />

    <TableView fx:id="tabelaTodas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="250.0" />
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150.0" />
            <TableColumn fx:id="colEstado" text="Estado Atual" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="100.0" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button text="Ver Detalhes Completos" onAction="#verDetalhes" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;">
            <padding><Insets top="10" bottom="10" left="20" right="20"/></padding>
        </Button>
    </HBox>

</VBox>