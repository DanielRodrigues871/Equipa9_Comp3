<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.DashboardEstudanteController">

    <!-- ===================== TOP ===================== -->
    <top>
        <HBox spacing="10" padding="10">
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#logout"/>
        </HBox>
    </top>

    <!-- ===================== LEFT (NAVIGATION) ===================== -->
    <left>
        <VBox spacing="10" padding="10" prefWidth="200">
            <Label text="Menu Estudante"
                   style="-fx-font-weight: bold;"/>

            <Button text="Dashboard" disable="true"/>
            <Button text="Ofertas Aprovadas" onAction="#verOfertas"/>
            <Button text="Minhas Candidaturas" onAction="#verCandidaturas"/>
            <Button text="Candidatar a Oferta" onAction="#candidatar"/>
            <Button text="Notificações" onAction="#verNotificacoes"/>
        </VBox>
    </left>

    <!-- ===================== CENTER ===================== -->
    <center>
        <VBox spacing="20" alignment="CENTER">
            <Label text="Área do Estudante"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Utilize o menu à esquerda para navegar."
                   style="-fx-font-size: 14px;"/>
        </VBox>
    </center>

</BorderPane>
