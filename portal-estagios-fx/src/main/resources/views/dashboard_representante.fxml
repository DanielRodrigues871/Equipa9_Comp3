<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.DashboardRepresentanteController">

    <!-- ===================== TOP ===================== -->
    <top>
        <HBox spacing="10" padding="10">
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#logout"/>
        </HBox>
    </top>

    <!-- ===================== LEFT (MENU) ===================== -->
    <left>
        <VBox spacing="10" padding="10" prefWidth="200">
            <Label text="Menu Representante"
                   style="-fx-font-weight: bold;"/>

            <Button text="Dashboard" disable="true"/>
            <Button text="Criar Proposta" onAction="#criarProposta"/>
            <Button text="Minhas Propostas" onAction="#verPropostas"/>
            <Button text="Gestão de Empresas" onAction="#menuEmpresas"/>
            <Button text="Notificações" onAction="#verNotificacoes"/>
        </VBox>
    </left>

    <!-- ===================== CENTER ===================== -->
    <center>
        <VBox spacing="20" alignment="CENTER">
            <Label text="Área do Representante"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Utilize o menu à esquerda para navegar."/>
        </VBox>
    </center>

</BorderPane>
