<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.EditarOfertaController"
      spacing="12" alignment="CENTER" padding="20">

    <Label text="Editar Oferta" style="-fx-font-size:20px;"/>

    <TextField fx:id="tituloField" promptText="Título"/>
    <TextArea fx:id="descricaoArea" promptText="Descrição" prefHeight="80"/>
    <TextArea fx:id="requisitosArea" promptText="Requisitos" prefHeight="80"/>
    <TextField fx:id="localizacaoField" promptText="Localização"/>
    <TextField fx:id="duracaoField" promptText="Duração (meses)"/>
    <TextField fx:id="vagasField" promptText="Vagas"/>

    <Label fx:id="errorLabel" textFill="red"/>

    <Button text="Guardar Alterações" onAction="#guardar"/>
    <Button text="Voltar" onAction="#voltar"/>

</VBox>
