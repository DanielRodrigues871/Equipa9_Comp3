<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.EstatisticasFXController"
      spacing="10" alignment="TOP_LEFT" padding="20">

    <Label text="Estatísticas do Portal" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Separator/>

    <Label text="Propostas:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <Label fx:id="propostasAprovadas" />
    <Label fx:id="propostasPendentes" />
    <Label fx:id="propostasRejeitadas" />

    <Separator/>

    <Label text="Estágios sem candidaturas:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <Label fx:id="estagiosSemCandidaturas" />

    <Separator/>

    <Label text="Cursos mais procurados:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <ListView fx:id="listCursos" prefHeight="120"/>

    <Separator/>

    <Label text="Empresas mais procuradas:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <ListView fx:id="listEmpresasMais" prefHeight="120"/>

    <Separator/>

    <Label text="Empresas menos procuradas:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <ListView fx:id="listEmpresasMenos" prefHeight="120"/>

    <Separator/>

    <Button text="Voltar" onAction="#voltar"/>
</VBox>
