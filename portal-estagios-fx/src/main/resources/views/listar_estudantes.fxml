<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upt.pt.fx.controller.ListarEstudantesController">

    <!-- ===================== TOP ===================== -->
    <top>
        <HBox spacing="10" padding="10">
            <Label text="Estudantes"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar" onAction="#voltar"/>
        </HBox>
    </top>

    <!-- ===================== LEFT (NAVIGATION) ===================== -->
    <left>
        <VBox spacing="10" padding="10" prefWidth="180">
            <Label text="Navigation"
                   style="-fx-font-weight: bold;"/>

            <Button text="Estudantes" disable="true"/>
            <Button text="Cursos"/>
            <Button text="Ofertas"/>
            <Button text="Candidaturas"/>
        </VBox>
    </left>

    <!-- ===================== CENTER ===================== -->
    <center>
        <VBox spacing="10" padding="10">

            <TableView fx:id="tabela" prefHeight="400">

                <columns>
                    <TableColumn fx:id="colNome"
                                 text="Nome"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colEmail"
                                 text="Email"
                                 prefWidth="260"/>

                    <TableColumn fx:id="colNumero"
                                 text="Número Aluno"
                                 prefWidth="180"/>
                </columns>

                <placeholder>
                    <Label text="No content in table"/>
                </placeholder>

            </TableView>

        </VBox>
    </center>

</BorderPane>
