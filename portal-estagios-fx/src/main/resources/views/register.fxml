<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.RegisterController"
      stylesheets="@../css/style.css">
      
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Criar Conta" style="-fx-font-size: 20px;"/>
    
    <Label fx:id="errorLabel" textFill="red"/>


    <ComboBox fx:id="tipoCombo" promptText="Selecione o tipo de utilizador"/>

    <Button text="Continuar" onAction="#continuar"/>

    <Button text="Voltar ao Login" onAction="#voltarLogin" />
</VBox>

