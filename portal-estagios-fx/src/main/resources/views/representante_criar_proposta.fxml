<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.upt.pt.fx.controller.RepresentanteCriarPropostaController">

    <padding>
        <Insets bottom="40.0" left="80.0" right="80.0" top="40.0" />
    </padding>

    <Label text="Nova Proposta de Estágio" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>

    <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" style="-fx-font-weight: bold;"/>

    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Título da Oferta:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="tituloField" promptText="Ex: Desenvolvedor Fullstack" />
    </VBox>

    <HBox spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Tipo:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="tipoCombo" maxWidth="Infinity" promptText="Selecione..." />
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Localização:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="localizacaoField" promptText="Ex: Lisboa / Híbrido" />
        </VBox>
    </HBox>

    <HBox spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Vagas:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="vagasField" promptText="Ex: 2" />
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Duração (meses):" style="-fx-font-weight: bold;"/>
            <TextField fx:id="duracaoField" promptText="Ex: 6" />
        </VBox>
    </HBox>

    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Descrição:" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="descricaoArea" prefHeight="80.0" promptText="Descreva as funções do estágio..." wrapText="true"/>
    </VBox>

    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Requisitos:" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="requisitosArea" prefHeight="60.0" promptText="Ex: Java, SQL, Proatividade..." wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <padding>
            <Insets top="15.0" />
        </padding>
        
        <Button text="Cancelar" onAction="#voltar" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;"/>
        
        <Button text="✅ Criar Proposta" onAction="#criar" 
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
    </HBox>

</VBox>