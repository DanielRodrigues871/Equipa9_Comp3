<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.ListarPropostasController"
      spacing="10"
      padding="20">

    <HBox spacing="10">
        <Label text="Propostas do Representante" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Refresh" onAction="#carregar"/>
    </HBox>

    <TableView fx:id="tabela" prefHeight="300">

        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="150"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="200"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
            <TableColumn fx:id="colVagas" text="Vagas" prefWidth="80"/>
            <TableColumn fx:id="colDuracao" text="Duração" prefWidth="100"/>
        </columns>

    </TableView>

    <HBox spacing="10">
        <Button text="Editar" onAction="#editar"/>
        <Button text="Voltar" onAction="#voltar"/>
    </HBox>

</VBox>
