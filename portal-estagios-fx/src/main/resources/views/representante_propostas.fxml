<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.upt.pt.fx.controller.RepresentantePropostasController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Título -->
    <Label text="Minhas Propostas de Estágio"
           style="-fx-font-weight: bold; -fx-font-size: 24px;" />

    <!-- Tabela de propostas -->
    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"      text="ID"       prefWidth="150.0"/>
            <TableColumn fx:id="colTitulo"  text="Título"   prefWidth="220.0"/>
            <TableColumn fx:id="colEstado"  text="Estado"   prefWidth="120.0"/>
            <TableColumn fx:id="colVagas"   text="Vagas"    prefWidth="80.0"/>
            <TableColumn fx:id="colDuracao" text="Duração"  prefWidth="100.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Barra de ações -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="🔄 Atualizar"
                onAction="#carregar"
                style="-fx-cursor: hand;" />

        <Button text="✏ Editar Proposta Selecionada"
                onAction="#editar"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;">
            <padding>
                <Insets top="10" bottom="10" left="20" right="20"/>
            </padding>
        </Button>

        <Button text="Voltar"
                onAction="#voltar"
                style="-fx-cursor: hand;" />
    </HBox>

</VBox>
