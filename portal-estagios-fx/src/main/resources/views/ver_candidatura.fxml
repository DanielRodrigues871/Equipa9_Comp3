<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.VerCandidaturaController"
      spacing="15" padding="20" alignment="CENTER">

    <Label text="Detalhes da Candidatura" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="estudanteLabel" style="-fx-font-size: 16px;"/>
    <Label fx:id="estadoLabel" style="-fx-font-size: 16px;"/>
    <Label fx:id="dataLabel" style="-fx-font-size: 16px;"/>

    <Label text="Carta de Motivação:" style="-fx-font-size:16px; -fx-font-weight:bold;"/>

    <TextArea fx:id="cartaArea" editable="false" prefHeight="200" prefWidth="500"/>

    <HBox spacing="15">
        <Button text="Aprovar" onAction="#aprovar"/>
        <Button text="Rejeitar" onAction="#rejeitar"/>
        <Button text="Voltar" onAction="#voltar"/>
    </HBox>

</VBox>
