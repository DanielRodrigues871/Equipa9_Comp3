<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane fx:id="contentPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.upt.pt.fx.controller.VerEmpresaController">

    <VBox spacing="12" alignment="CENTER_LEFT" padding="20">
        <Label text="Dados da Empresa" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        
        <!-- Labels para mostrar dados (não editáveis) -->
        <Label text="Nome: " fx:id="nomeLabel"/>
        <Label text="NIF: " fx:id="nifLabel"/>
        <Label text="Email: " fx:id="emailLabel"/>
        <Label text="Morada: " fx:id="moradaLabel"/>
        <Label text="Estado: " fx:id="estadoLabel"/>

        <Button text="Voltar" onAction="#voltar"/>
    </VBox>

</AnchorPane>
