<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upt.pt.fx.controller.DashboardRepresentanteController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="400">

    <Label fx:id="welcomeLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Button text="Criar Proposta de Estágio" onAction="#criarProposta"/>
    <Button text="Minhas Propostas" onAction="#verPropostas"/>
    <Button text="Gestão de Empresas" onAction="#menuEmpresas"/>
    <Button text="Notificações" onAction="#verNotificacoes"/>

    <Button text="Logout" onAction="#logout"/>

</VBox>
