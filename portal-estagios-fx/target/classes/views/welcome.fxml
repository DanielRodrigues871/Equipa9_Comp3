<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.upt.pt.fx.controller.WelcomeController">
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" 
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/Gemini_Generated_Image_9m5poe9m5poe9m5p.png" />
         </image>
         <effect>
            <GaussianBlur radius="5.0" />
         </effect>
      </ImageView>

      <VBox alignment="CENTER" fillWidth="false">
         <children>
            <VBox alignment="CENTER" spacing="25.0" 
                  style="-fx-background-color: rgba(255, 255, 255, 0.90); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);">
               <children>
                  <Label text="PORTAL DE ESTÁGIOS" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Label>

                  <Button mnemonicParsing="false" onAction="#goToLogin" prefWidth="250.0" 
                          style="-fx-background-color: #0056b3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" 
                          text="LOGIN">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="12.0" top="12.0" />
                     </padding>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#goToRegister" prefWidth="250.0" 
                          style="-fx-background-color: #218838; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" 
                          text="CRIAR CONTA">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="12.0" top="12.0" />
                     </padding>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="50.0" left="60.0" right="60.0" top="50.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>